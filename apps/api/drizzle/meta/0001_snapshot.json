        "run_attempts_start_valid": {
          "name": "run_attempts_start_valid",
          "value": "\n      (\"nexus\".\"run_attempts\".\"state\" <> 'pending' OR \"nexus\".\"run_attempts\".\"started_at\" IS NULL)\n      AND (\"nexus\".\"run_attempts\".\"state\" <> 'running' OR \"nexus\".\"run_attempts\".\"started_at\" IS NOT NULL)\n      AND \"nexus\".\"run_attempts\".\"started_at\" >= \"nexus\".\"run_attempts\".\"created_at\"\n    "
        },
        "run_attempts_finish_valid": {
          "name": "run_attempts_finish_valid",
          "value": "\n      (\"nexus\".\"run_attempts\".\"state\" IN ('succeeded', 'failed', 'cancelled')) = (\"nexus\".\"run_attempts\".\"finished_at\" IS NOT NULL)\n      AND \"nexus\".\"run_attempts\".\"finished_at\" >= coalesce(\"nexus\".\"run_attempts\".\"started_at\", \"nexus\".\"run_attempts\".\"created_at\")\n    "
        },
        "run_attempts_output_state": {
          "name": "run_attempts_output_state",
          "value": "(\"nexus\".\"run_attempts\".\"state\" = 'succeeded') = (\"nexus\".\"run_attempts\".\"output\" IS NOT NULL)"
        },
        "run_attempts_error_state": {
          "name": "run_attempts_error_state",
          "value": "(\"nexus\".\"run_attempts\".\"state\" = 'failed') = (\"nexus\".\"run_attempts\".\"error\" IS NOT NULL)"
        },
        "run_attempts_error_format": {
          "name": "run_attempts_error_format",
          "value": "\n      \"nexus\".\"run_attempts\".\"error\" IS NULL OR (\n        jsonb_typeof(\"nexus\".\"run_attempts\".\"error\") = 'object'\n        AND \"nexus\".\"run_attempts\".\"error\" - 'category' - 'code' - 'message' = '{}'::jsonb\n        AND \"nexus\".\"run_attempts\".\"error\"->>'category' IN ('platform', 'provider', 'tool')\n        AND jsonb_typeof(\"nexus\".\"run_attempts\".\"error\"->'code') = 'string' AND \"nexus\".\"run_attempts\".\"error\"->>'code' ~ '[^[:space:]]'\n        AND jsonb_typeof(\"nexus\".\"run_attempts\".\"error\"->'message') = 'string' AND \"nexus\".\"run_attempts\".\"error\"->>'message' ~ '[^[:space:]]'\n      ) IS TRUE\n    "
        }
      },
