# Published on 127.0.0.1 only.
WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5432

# Disposable credentials for local development.
POSTGRES_DB=nexus
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_local

# Database access from applications running on the host.
DATABASE_URL=postgresql://nexus:nexus_local@127.0.0.1:5432/nexus