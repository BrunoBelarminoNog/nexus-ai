{
    "$schema": "https://turborepo.dev/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**",
                ".next/**",
                "!.next/cache/**"
            ]
        },
        "test": {
            "outputs": [
                "coverage/**"
            ],
            "dependsOn": [
                "build"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true
        }
    }
}